# ---- models (any provider; see docs) ----
# provider/model, gateway/provider/model, or provider/model@http://host/v1 for OpenAI-compatible servers
MODEL_CHAT=anthropic/claude-sonnet-4-6
# MODEL_CHAT=openai/gpt-5.6
# MODEL_CHAT=xai/grok-4.3
# MODEL_CHAT=moonshot/kimi-k2.7
# MODEL_CHAT=openrouter/deepseek/deepseek-v4
# MODEL_CHAT=ollama/qwen3:8b
# MODEL_CHAT=custom/qwen3-32b@http://gpu-box:8000/v1
MODEL_FAST=
MODEL_EMBED=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ---- storage ----
# leave empty to use a local SQLite file (./data/agent.db); set to use Postgres from deploy/compose
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
REDIS_URL=redis://localhost:6379

# ---- agent workspace & local data (relative paths resolve from the repo root) ----
AGENT_WORKSPACE=./workspace
AGENT_DATA_DIR=./data
