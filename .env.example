# ---- models (any provider; see docs) ----
# provider/model, gateway/provider/model, or provider/model@http://host/v1 for OpenAI-compatible servers
MODEL_CHAT=anthropic/claude-sonnet-4-6
# MODEL_CHAT=openai/gpt-5.6
# MODEL_CHAT=xai/grok-4.3
# MODEL_CHAT=moonshot/kimi-k2.7
# MODEL_CHAT=openrouter/deepseek/deepseek-v4
# MODEL_CHAT=ollama/qwen3:8b
# MODEL_CHAT=custom/qwen3-32b@http://gpu-box:8000/v1
MODEL_FAST=
MODEL_EMBED=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ---- storage ----
# leave empty to use a local SQLite file (./data/agent.db); set to use Postgres from deploy/compose
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
REDIS_URL=redis://localhost:6379

# ---- agent workspace & local data (relative paths resolve from the repo root) ----
AGENT_WORKSPACE=./workspace
AGENT_DATA_DIR=./data

# ---- payment policy (USDC on XDC mainnet; enforced locally before any paid call) ----
PAY_AUTO_APPROVE_BELOW_USDC=0.05
PAY_PER_CALL_MAX_USDC=1
PAY_DAILY_CAP_USDC=2
# PAY_ALLOWED_PROVIDERS=TradeFi Network,Gas Tracker

# ---- dashboard ----
# shared secret between dashboard and agent API (leave empty on a trusted laptop)
KIT_API_TOKEN=
# password for the dashboard login (leave empty to keep it open on localhost)
DASHBOARD_PASSWORD=
DASHBOARD_URL=http://localhost:3000
AGENT_URL=http://localhost:4111
COPILOTKIT_TELEMETRY_DISABLED=true
MASTRA_TELEMETRY_DISABLED=1

# ---- channels ----
# Telegram: token from @BotFather. Access is default-deny: pair with the code printed at startup (/pair CODE),
# or pre-allow numeric Telegram user ids here. Admins get approval requests with Approve/Deny buttons.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_USER_IDS=

# ---- sandbox (opt-in) ----
# SANDBOX=local (default) gives the agent a `run_command` tool in an isolated scratch dir (Seatbelt on macOS, Bubblewrap on Linux).
# Network is blocked inside the sandbox unless SANDBOX_ALLOW_NETWORK=1. Destructive commands are refused outright.
SANDBOX=local
SANDBOX_ALLOW_NETWORK=0

# ---- secrets (optional) ----
# Any value may be a reference instead of the secret itself:
#   ANTHROPIC_API_KEY=op://Private/Anthropic/credential     (1Password CLI `op` must be logged in)
#   OPENAI_API_KEY=bws://5b3f…                               (Bitwarden Secrets Manager CLI `bws`)
# Or point at any vault CLI that prints KEY=VALUE lines; it fills keys that are still empty:
# SECRETS_COMMAND=op inject -i secrets.tpl
# SECRETS_OVERRIDE=0   # set 1 to let the helper replace values already in .env
